# Server-only variables. Never expose these through EXPO_PUBLIC_*.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_server_only_service_role_key

# RevenueCat server verification. Use the project API key only on the server;
# never put this in an EXPO_PUBLIC_* variable. The entitlement ID must match
# the separate professional Pro entitlement in RevenueCat.
REVENUECAT_API_KEY=
REVENUECAT_PRO_ENTITLEMENT_ID=pro
REVENUECAT_WEBHOOK_AUTH_TOKEN=

SERVER_HOST=0.0.0.0
SERVER_PORT=3000
NODE_ENV=development

# API security. Native clients do not send an Origin header. Set this explicitly
# for the website and any other supported web deployment; production defaults to no browser origins.
# Example: https://get-deal-drop.com,https://www.get-deal-drop.com
SERVER_ALLOWED_ORIGINS=
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_GENERAL=120
API_RATE_LIMIT_SEARCH=30
API_RATE_LIMIT_WATCHLIST_MUTATION=20
API_RATE_LIMIT_EVENT_CAPTURE=60
API_RATE_LIMIT_PUSH_TOKEN_REGISTRATION=10
API_RATE_LIMIT_NOTIFICATION_ACTION=30
API_RATE_LIMIT_RESOURCE_MUTATION=30
API_MAX_CONCURRENT_SEARCHES=8
# Image recognition sends compressed base64 images through the authenticated API.
API_MAX_BODY_BYTES=8000000
API_MAX_URL_BYTES=8192
API_REQUEST_TIMEOUT_MS=30000
API_TRUST_PROXY=false

# Server-only currency conversion. The provider path fetches current published rates and caches
# them briefly. Keep source prices unchanged; converted values remain estimates.
DEALDROP_EXCHANGE_RATES_PROVIDER=frankfurter
DEALDROP_EXCHANGE_RATES_API_URL=https://api.frankfurter.dev/v2
DEALDROP_EXCHANGE_RATES_DATA_PROVIDER=
DEALDROP_EXCHANGE_RATES_CACHE_TTL_MS=3600000
DEALDROP_EXCHANGE_RATES_TIMEOUT_MS=5000

# Optional controlled override for tests or a reviewed internal rate table. When set, this takes
# precedence over the provider and requires an ISO timestamp.
# Example: {"USD":{"NGN":1500},"NGN":{"USD":0.000667}}
DEALDROP_EXCHANGE_RATES_JSON=
DEALDROP_EXCHANGE_RATES_AS_OF=
DEALDROP_EXCHANGE_RATES_SOURCE=configured_rate_table

# Optional server-only structured image-recognition provider. Gemini is the
# supported low-cost pilot provider; the server converts its JSON response to
# the dealdrop.product_recognition.v1 contract. Image bytes are not stored by
# DealDrop after recognition.
PRODUCT_IMAGE_RECOGNITION_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash-lite:generateContent
PRODUCT_IMAGE_RECOGNITION_API_KEY=
PRODUCT_IMAGE_RECOGNITION_PROVIDER=gemini
PRODUCT_IMAGE_RECOGNITION_MODEL=gemini-2.5-flash-lite

# eBay Browse API (server-only; register application keys in the eBay Developer Program).
# Browse API uses an application access token minted from the client credentials grant.
EBAY_ENVIRONMENT=production
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_OAUTH_SCOPE=https://api.ebay.com/oauth/api_scope
EBAY_MARKETPLACE_ID=EBAY_US
EBAY_MARKETPLACE_COUNTRY=US
EBAY_CURRENCY=USD
EBAY_PAGE_SIZE=24
EBAY_REQUEST_TIMEOUT_MS=30000
EBAY_RETRY_ATTEMPTS=3
EBAY_RETRY_BASE_DELAY_MS=500

# Etsy Open API v3 (server-only; create a Personal App for limited-scale beta access).
ETSY_API_KEYSTRING=
ETSY_SHARED_SECRET=
ETSY_API_BASE_URL=https://api.etsy.com/v3
ETSY_BUYER_COUNTRY=
ETSY_SHOP_LOCATION=
ETSY_CURRENCY=USD
ETSY_PAGE_SIZE=24
ETSY_REQUEST_TIMEOUT_MS=30000
ETSY_RETRY_ATTEMPTS=3
ETSY_RETRY_BASE_DELAY_MS=500

# Rakuten Ichiba Item Search API (server-only; register a Rakuten Web Service application).
RAKUTEN_APPLICATION_ID=
RAKUTEN_ACCESS_KEY=
RAKUTEN_API_BASE_URL=https://openapi.rakuten.co.jp
RAKUTEN_ITEM_SEARCH_API_VERSION=20260701
RAKUTEN_CURRENCY=JPY
RAKUTEN_AVAILABLE_ONLY=true
RAKUTEN_PAGE_SIZE=24
RAKUTEN_REQUEST_TIMEOUT_MS=30000
RAKUTEN_RETRY_ATTEMPTS=3
RAKUTEN_RETRY_BASE_DELAY_MS=500

# Amazon Business Product Search API (server-only; official API access required).
# Keep disabled until Amazon Business approves the application and Product Search role.
AMAZON_BUSINESS_ENABLED=false
AMAZON_BUSINESS_ENVIRONMENT=sandbox
AMAZON_BUSINESS_PRODUCTION_APPROVED=false
AMAZON_BUSINESS_USER_EMAIL=
AMAZON_BUSINESS_CLIENT_ID=
AMAZON_BUSINESS_CLIENT_SECRET=
AMAZON_BUSINESS_REFRESH_TOKEN=
AMAZON_BUSINESS_PRODUCT_REGION=US
AMAZON_BUSINESS_SHIPPING_REGION=
AMAZON_BUSINESS_SHIPPING_POSTAL_CODE=
AMAZON_BUSINESS_LOCALE=en_US
AMAZON_BUSINESS_CURRENCY=USD
AMAZON_BUSINESS_GROUP_TAG=
AMAZON_BUSINESS_PAGE_SIZE=24
AMAZON_BUSINESS_REQUEST_TIMEOUT_MS=30000
AMAZON_BUSINESS_RETRY_ATTEMPTS=3
AMAZON_BUSINESS_RETRY_BASE_DELAY_MS=500

# Production watchlist monitoring worker (server-only).
# 0 runs once; 300000 monitors every five minutes.
WATCHLIST_MONITOR_INTERVAL_MS=300000
WATCHLIST_MONITOR_RETRY_ATTEMPTS=3
WATCHLIST_MONITOR_RETRY_BASE_DELAY_MS=1000
WATCHLIST_MONITOR_SEARCH_LIMIT=24
WATCHLIST_MONITOR_SEARCH_TIMEOUT_MS=30000
# Omit to consider every configured adapter; use stable IDs to disable sources explicitly.
WATCHLIST_MONITOR_ENABLED_SOURCES=ebay,etsy,rakuten
# The API reports the worker as stale after this heartbeat age.
WATCHLIST_MONITOR_STALE_AFTER_MS=900000
WATCHLIST_MONITOR_SOURCE_FAILURE_ALERT_THRESHOLD=3
WATCHLIST_MONITOR_NOTIFICATION_FAILURE_ALERT_THRESHOLD=3
