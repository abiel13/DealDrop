# Server-only variables. Never expose these through EXPO_PUBLIC_*.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_server_only_service_role_key

SERVER_HOST=0.0.0.0
SERVER_PORT=3000
NODE_ENV=development

# Production: use a saved browser session. The worker never attempts a CAPTCHA bypass.
FACEBOOK_AUTH_MODE=storage
FACEBOOK_STORAGE_STATE_PATH=./server/.auth/facebook.json
FACEBOOK_AUTH_TIMEOUT_MS=120000

# One-time bootstrap: set AUTH_MODE=interactive and HEADLESS=false, complete login once,
# then switch AUTH_MODE back to storage and keep the generated state file private.
FACEBOOK_EMAIL=
FACEBOOK_PASSWORD=
FACEBOOK_HEADLESS=true
FACEBOOK_MAX_PAGES=3
FACEBOOK_MAX_LISTINGS_PER_PAGE=24
FACEBOOK_RATE_LIMIT_MS=2500
FACEBOOK_RETRY_ATTEMPTS=3
FACEBOOK_RETRY_BASE_DELAY_MS=1500
FACEBOOK_REQUEST_TIMEOUT_MS=30000
# 0 runs once; 300000 polls every five minutes.
FACEBOOK_POLL_INTERVAL_MS=0

# eBay Browse API (server-only; register application keys in the eBay Developer Program).
# Browse API uses an application access token minted from the client credentials grant.
EBAY_ENVIRONMENT=production
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_OAUTH_SCOPE=https://api.ebay.com/oauth/api_scope
EBAY_MARKETPLACE_ID=EBAY_US
EBAY_MARKETPLACE_COUNTRY=US
EBAY_CURRENCY=USD
EBAY_PAGE_SIZE=24
EBAY_REQUEST_TIMEOUT_MS=30000
EBAY_RETRY_ATTEMPTS=3
EBAY_RETRY_BASE_DELAY_MS=500

# Etsy Open API v3 (server-only; create a Personal App for limited-scale beta access).
ETSY_API_KEYSTRING=
ETSY_SHARED_SECRET=
ETSY_API_BASE_URL=https://api.etsy.com/v3
ETSY_BUYER_COUNTRY=
ETSY_SHOP_LOCATION=
ETSY_CURRENCY=USD
ETSY_PAGE_SIZE=24
ETSY_REQUEST_TIMEOUT_MS=30000
ETSY_RETRY_ATTEMPTS=3
ETSY_RETRY_BASE_DELAY_MS=500
