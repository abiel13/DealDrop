EXPO_PUBLIC_SUPABASE_URL=your_supabase_url
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# Development: http://localhost:3000/api/v1 (use the host-reachable URL for a device/emulator)
# Production: set the deployed DealDrop API URL in the EAS production environment.
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1
EXPO_PUBLIC_EAS_PROJECT_ID=your_eas_project_id
# These RevenueCat app-specific public SDK keys are embedded in the mobile bundle.
# Configure them in EAS for each build environment; never put secret keys here.
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=your_revenuecat_android_public_api_key
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=your_revenuecat_ios_public_api_key
# This identifier must match the active RevenueCat entitlement for both stores.
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID=premium
