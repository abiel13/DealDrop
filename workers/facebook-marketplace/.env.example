# Server-only worker variables. Never expose these through EXPO_PUBLIC_*.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_server_only_service_role_key

# Production: use a saved browser session. The worker never attempts a CAPTCHA bypass.
FACEBOOK_AUTH_MODE=storage
FACEBOOK_STORAGE_STATE_PATH=./workers/facebook-marketplace/.auth/facebook.json

# One-time bootstrap: set AUTH_MODE=interactive and HEADLESS=false, complete login once,
# then switch AUTH_MODE back to storage and keep the generated state file private.
FACEBOOK_AUTH_TIMEOUT_MS=120000

# Optional fallback; Facebook may still require verification and can reject automation.
FACEBOOK_EMAIL=
FACEBOOK_PASSWORD=

FACEBOOK_HEADLESS=true
FACEBOOK_MAX_PAGES=3
FACEBOOK_MAX_LISTINGS_PER_PAGE=24
FACEBOOK_RATE_LIMIT_MS=2500
FACEBOOK_RETRY_ATTEMPTS=3
FACEBOOK_RETRY_BASE_DELAY_MS=1500
FACEBOOK_REQUEST_TIMEOUT_MS=30000
# Keep the worker process running to pick up new watchlists without a manual rerun.
# 0 runs once; 300000 polls every five minutes.
FACEBOOK_POLL_INTERVAL_MS=0
